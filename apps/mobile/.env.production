# Mobile production env — committed so external users can build a personal
# iPhone copy of AI Gauntlet against the same backend as ai-gauntlet.org on web.
# Loaded by the `*:prod` scripts via dotenv-cli (see package.json).
EXPO_PUBLIC_API_URL=https://api.ai-gauntlet.org
EXPO_PUBLIC_WEB_URL=https://github.com/utkarshhhsinha/AI-Gauntlet
